# Anthropic API key for Capitán Lunático's brain. Set a monthly spend cap in the Console.
ANTHROPIC_API_KEY=

# Models. Opus 5.5 for the Capitán, Haiku 5.5 for cheap mechanical steps.
DIRECTOR_MODEL=claude-opus-5-5
HELPER_MODEL=claude-haiku-5-5

# Local dev store: a JSON file. Leave unset to use an in-memory store that resets each run.
CRUCERO_DATA_FILE=.data/crucero.json

# Ship's clock (Acapulco / Mexico City, no DST since 2022 → fixed UTC-6)
CRUCERO_TZ=America/Mexico_City

# --- Server (apps/server) ---
PORT=8080
# Public URL Twilio calls; required for webhook signature validation in production.
PUBLIC_URL=http://localhost:8080
# Postgres (Supabase) connection string. Leave unset to use the JSON dev store.
DATABASE_URL=
# Scheduler on by default; set SCHEDULER=off to run the webhook only.
SCHEDULER=on
# Send the morning as a WhatsApp template knock (on) or as a direct message (off, fine for the sandbox).
WHATSAPP_TEMPLATES=off

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Only needed to validate inbound webhook signatures (recommended in production).
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 · Production: your approved sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content SIDs (HX…) once templates are approved; blank = plain-text fallback
TWILIO_TEMPLATE_MORNING_KNOCK=
TWILIO_TEMPLATE_REMINDER=
TWILIO_TEMPLATE_NEW_ACTIVITY=
