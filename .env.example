# Anthropic API key for Capitán Lunático's brain. Set a monthly spend cap in the Console.
ANTHROPIC_API_KEY=

# Models. Opus 5.5 for the Capitán, Haiku 5.5 for cheap mechanical steps.
DIRECTOR_MODEL=claude-opus-5-5
HELPER_MODEL=claude-haiku-5-5

# Local dev store: a JSON file. Leave unset to use an in-memory store that resets each run.
CRUCERO_DATA_FILE=.data/crucero.json
# SEED_SAMPLE=off   # start with an empty roster instead of the sample family (Fly sets this)
# PRIVACY_CONTACT=organizador@example.com   # shown on /privacy as the contact for data requests

# Telegram bot (from @BotFather). When set, Telegram is the channel and the WhatsApp webhooks are closed.
# The server registers PUBLIC_URL/webhooks/telegram with Telegram on every boot.
# TELEGRAM_BOT_TOKEN=123456789:AA...

# Ship's clock (Acapulco / Mexico City, no DST since 2022 → fixed UTC-6)
CRUCERO_TZ=America/Mexico_City

# --- Server (apps/server) ---
PORT=8080
# Public URL Twilio calls; required for webhook signature validation in production.
PUBLIC_URL=http://localhost:8080
# Postgres (Supabase) connection string. Leave unset to use the JSON dev store.
DATABASE_URL=
# Scheduler on by default; set SCHEDULER=off to run the webhook only.
SCHEDULER=on
# Send the morning as a WhatsApp template knock (on) or as a direct message (off, fine for the sandbox).
WHATSAPP_TEMPLATES=off

# --- Meta WhatsApp Cloud API (preferred; set these and TWILIO_* is ignored) ---
# From Meta for Developers → your app → WhatsApp → API Setup.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App → App settings → Basic → App secret. Validates webhook signatures.
META_APP_SECRET=
# Any string you choose; type the same one in the webhook configuration screen.
META_VERIFY_TOKEN=crucero-luna-2026
# Graph API version (Meta retires versions ~2 years after release).
META_GRAPH_VERSION=v22.0
# Approved template names and language, once you have them; blank = plain-text fallback.
META_TEMPLATE_LANG=es_MX
META_TEMPLATE_MORNING_KNOCK=
META_TEMPLATE_REMINDER=
META_TEMPLATE_NEW_ACTIVITY=

# --- Twilio WhatsApp (alternative provider; only used when META_* is unset) ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Only needed to validate inbound webhook signatures (recommended in production).
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 · Production: your approved sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content SIDs (HX…) once templates are approved; blank = plain-text fallback
TWILIO_TEMPLATE_MORNING_KNOCK=
TWILIO_TEMPLATE_REMINDER=
TWILIO_TEMPLATE_NEW_ACTIVITY=
